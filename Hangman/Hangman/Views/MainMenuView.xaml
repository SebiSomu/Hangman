<UserControl x:Class="Hangman.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Hangman.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#6366F1"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="BackgroundSubtleColor" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="CardHoverColor" Color="#F3F4F6"/>

        <!-- Menu Card Style - smaller for horizontal layout -->
        <Style x:Key="MenuCard" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHoverColor}"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogoutButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ErrorColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource ErrorColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundSubtleColor}" Padding="32,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- User Profile -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimaryColor}" Margin="0,0,16,0">
                        <Ellipse Width="46" Height="46">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WelcomeMessage}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Ready to play?" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Logout Button -->
                <Button Grid.Column="2" Style="{StaticResource LogoutButton}" 
                        Content="Logout" Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <!-- Menu Grid -->
                <UniformGrid Columns="3" Rows="2" Margin="0,0,0,32">
                    <!-- New Game -->
                    <Button Style="{StaticResource MenuCard}" Margin="12"
                            Command="{Binding NewGameCommand}">
                        <StackPanel>
                            <TextBlock Text="🎮" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="New Game" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Start a new game" FontSize="13" 
                                       Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Continue Game -->
                    <Button Style="{StaticResource MenuCard}" Margin="12"
                            Command="{Binding ContinueGameCommand}">
                        <StackPanel>
                            <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Continue Game" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Load saved game" FontSize="13" 
                                       Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Statistics -->
                    <Button Style="{StaticResource MenuCard}" Margin="12"
                            Command="{Binding StatisticsCommand}">
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Statistics" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="View your progress" FontSize="13" 
                                       Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Player Settings -->
                    <Button Style="{StaticResource MenuCard}" Margin="12"
                            Command="{Binding PlayerSettingsCommand}">
                        <StackPanel>
                            <TextBlock Text="⚙️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Change profile picture" FontSize="13" 
                                       Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Delete Account -->
                    <Button Style="{StaticResource MenuCard}" Margin="12"
                            Command="{Binding DeleteAccountCommand}">
                        <StackPanel>
                            <TextBlock Text="🗑️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Delete Account" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource ErrorColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Remove account" FontSize="13" 
                                       Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
