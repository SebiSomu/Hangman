<UserControl x:Class="Hangman.Views.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Hangman.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#6366F1"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="BackgroundSubtleColor" Color="#F9FAFB"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageSelectButton" TargetType="Button">
            <Setter Property="Height" Value="120"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{StaticResource BackgroundSubtleColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="60">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToNullVisibilityConverter x:Key="StringToNullVisibilityConverter"/>
        <converters:AvatarFileNameToImageConverter x:Key="AvatarFileNameToImageConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <Border Grid.Column="0" Background="{StaticResource BackgroundSubtleColor}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <TextBlock Text="📝" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                <TextBlock Text="Join Us" FontSize="42" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryColor}" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Create a new account" FontSize="18" 
                           Foreground="{StaticResource TextSecondaryColor}" 
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Sign Up Form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Margin="48,32">
                <!-- Header -->
                <TextBlock Text="Create Account" FontSize="32" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                <TextBlock Text="Fill in your information below" FontSize="15" 
                           Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,24"/>

                <!-- Profile Image Selection -->
                <TextBlock Text="Profile Picture (optional)" FontSize="14" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,12"/>
                <Button Style="{StaticResource ImageSelectButton}" 
                        Command="{Binding SelectImageCommand}"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <Grid>
                        <!-- Default icon -->
                        <TextBlock Text="📷" FontSize="40"
                                   Visibility="{Binding AvatarImage, Converter={StaticResource StringToNullVisibilityConverter}}"/>
                        <!-- Selected image -->
                        <Ellipse Width="116" Height="116">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Button>

                <!-- Username Field -->
                <TextBlock Text="Username" FontSize="14" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource ModernTextBox}" 
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <!-- Password Field -->
                <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                <PasswordBox Style="{StaticResource ModernPasswordBox}" 
                             x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,16"/>

                <!-- Confirm Password Field -->
                <TextBlock Text="Confirm Password" FontSize="14" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                <PasswordBox Style="{StaticResource ModernPasswordBox}" 
                             x:Name="ConfirmPasswordBox"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                             Margin="0,0,0,8"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" FontSize="13" 
                           Foreground="{StaticResource ErrorColor}" 
                           TextWrapping="Wrap" Margin="0,0,0,20"/>

                <!-- Sign Up Button -->
                <Button Style="{StaticResource ModernButton}" 
                        Content="Create Account" 
                        Command="{Binding SignUpCommand}"
                        Margin="0,0,0,12"/>

                <!-- Back Button -->
                <Button Style="{StaticResource SecondaryButton}" 
                        Content="← Back to login" 
                        Command="{Binding BackCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Panel -->
        <Border Grid.Column="2" Background="{StaticResource BackgroundSubtleColor}"/>
    </Grid>
</UserControl>
